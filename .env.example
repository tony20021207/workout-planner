# ============================================================
# OptiMass environment variables
# ============================================================
#
# Copy this file to .env for local dev and fill in the values.
# Production env vars are set in the Railway / Vercel dashboards.

# ---------------- Server (Railway) ----------------

# MySQL connection string. On Railway, reference the auto-injected
# variable from the MySQL service:
#   DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://user:pass@host:3306/optimass

# Firebase Admin SDK credentials. Get these from the Firebase Console
# > Project Settings > Service Accounts > Generate New Private Key.
# FIREBASE_PRIVATE_KEY's value contains actual newline characters; if
# pasting through a UI that strips them, replace literal \n with real
# newlines before saving.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Anthropic API key — used by the rating engine for the LLM-generated
# prose (verdict, recommendations, coaching tone). Local-only scores
# come from poolScore.ts and don't need this.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins for the API. On Railway,
# set to your Vercel domain (and any custom domains you add later).
# Defaults to '*' which is fine for local dev + the bundled deploy
# where frontend + backend share an origin.
#   Example: CORS_ORIGINS=https://optimass.vercel.app,https://optimass.app
CORS_ORIGINS=*

# When 'false', the Express server does NOT serve the client static
# bundle — API-only mode used on Railway when Vercel hosts the
# frontend separately. Defaults to serving (back-compat with the
# bundled Manus deploy). Set to 'false' on Railway.
SERVE_CLIENT=true

# Optional: override the default port the server binds to. Railway
# injects PORT automatically, so leave unset there. Local dev only.
PORT=3000

# ---------------- Client (Vercel) ----------------

# Base URL for the API. Leave EMPTY for local dev (Vite proxies
# /api/trpc to the dev server) and for the bundled Manus deploy
# (frontend + backend on the same origin). On Vercel, set to your
# Railway API URL.
#   Example: VITE_API_URL=https://optimass-api.up.railway.app
VITE_API_URL=

# Firebase Web SDK client config. Get from Firebase Console >
# Project Settings > General > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
